page {
  background: #f5f7ff;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(236rpx + env(safe-area-inset-bottom));
  color: #111111;
  box-sizing: border-box;
}

.hero-scene {
  position: relative;
  margin: 24rpx 24rpx 0;
  background: #ffffff;
  height: 430rpx;
  border-radius: 30rpx;
  box-shadow: 0 22rpx 48rpx rgba(33, 90, 128, 0.13);
  box-sizing: border-box;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.hero-scene::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  background: rgba(3, 32, 51, 0.16);
}

.hero-scene::after {
  content: '';
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  bottom: 22rpx;
  z-index: 1;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.42);
}

.weather-badge {
  position: absolute;
  right: 28rpx;
  top: 28rpx;
  z-index: 2;
  width: 156rpx;
  min-height: 118rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
  border: none;
  border-radius: 0;
  box-shadow: none;
  text-shadow: 0 2rpx 10rpx rgba(13, 50, 75, 0.18);
}

.weather-icon {
  position: relative;
  width: 54rpx;
  height: 48rpx;
}

.sun-core {
  position: absolute;
  right: 5rpx;
  top: 2rpx;
  width: 34rpx;
  height: 34rpx;
  background: #f3a362;
  border-radius: 50%;
  box-shadow: 0 0 0 7rpx rgba(243, 163, 98, 0.22);
}

.cloud-main {
  display: none;
  position: absolute;
  left: 4rpx;
  bottom: 4rpx;
  width: 44rpx;
  height: 22rpx;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 20rpx;
  box-shadow: 0 -10rpx 0 -2rpx rgba(255, 255, 255, 0.94), 12rpx -16rpx 0 -4rpx rgba(255, 255, 255, 0.94);
}

.rain-line {
  display: none;
  position: absolute;
  bottom: -4rpx;
  width: 3rpx;
  height: 14rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 3rpx;
  transform: rotate(16deg);
}

.rain-line.one {
  left: 18rpx;
}

.rain-line.two {
  left: 36rpx;
}

.weather-icon.cloudy .cloud-main,
.weather-icon.rainy .cloud-main,
.weather-icon.rainy .rain-line {
  display: block;
}

.weather-icon.rainy .sun-core {
  display: none;
}

.weather-temp {
  margin-top: 10rpx;
  color: #ffffff;
  font-size: 25rpx;
  line-height: 1;
  font-weight: 800;
  white-space: nowrap;
  width: max-content;
}

.weather-desc {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 20rpx;
  line-height: 1;
  font-weight: 600;
}

.hero-copy {
  position: absolute;
  left: 42rpx;
  right: 196rpx;
  bottom: 82rpx;
  z-index: 2;
}

.kicker {
  position: relative;
  color: rgba(255, 255, 255, 0.78);
  font-size: 22rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 5rpx;
}

.hero-title {
  position: relative;
  margin-top: 34rpx;
  color: #ffffff;
  font-size: 78rpx;
  line-height: 1;
  font-weight: 900;
  letter-spacing: 0;
}

.hero-rule {
  position: relative;
  width: 72rpx;
  height: 3rpx;
  background: #c99468;
  margin-top: 26rpx;
}

.hero-sub {
  position: relative;
  margin-top: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 31rpx;
  line-height: 1.2;
  font-weight: 800;
  letter-spacing: 0;
}

.hero-code {
  position: relative;
  margin-top: 34rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.5);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.28);
  font-size: 24rpx;
  color: #ffffff;
}

.hero-code text:first-child {
  color: rgba(255, 255, 255, 0.62);
  font-size: 20rpx;
  letter-spacing: 3rpx;
  font-weight: 600;
}

.hero-code text:last-child {
  max-width: 62%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.code-invalid {
  margin-top: 22rpx;
  font-size: 24rpx;
  color: #ffd2d2;
  text-shadow: 0 2rpx 8rpx rgba(6, 28, 42, 0.35);
}

.summit-panel {
  position: relative;
  z-index: 3;
  margin: -46rpx 24rpx 0;
  padding: 26rpx 24rpx 28rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 32rpx 32rpx 18rpx 18rpx;
  box-shadow: 0 18rpx 46rpx rgba(33, 90, 128, 0.1);
  box-sizing: border-box;
}

.city-tabs {
  display: flex;
  padding: 8rpx;
  background: #f5f7ff;
  border-radius: 34rpx;
}

.weather-tab {
  flex: 1;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  color: #6f7788;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 30rpx;
}

.weather-tab.active {
  color: #ffffff;
  background: #215a80;
  box-shadow: 0 8rpx 18rpx rgba(33, 90, 128, 0.14);
}

.weather-line {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  flex-wrap: nowrap;
  color: #6f7788;
  font-size: 18rpx;
  line-height: 1.55;
  background: #f8fbff;
  border-radius: 28rpx;
}

.weather-line text {
  margin-right: 5rpx;
  white-space: nowrap;
}

.weather-line text:first-child {
  margin-right: 10rpx;
}

.weather-pin {
  display: block;
  width: 10rpx;
  height: 10rpx;
  background: #c99468;
  border-radius: 50%;
  box-shadow: 0 0 0 6rpx rgba(201, 148, 104, 0.13);
}

.weather-line text:nth-child(2) {
  color: #152f41;
  font-weight: 700;
}

.weather-sep {
  display: inline-block;
  color: #c99468;
  font-size: 24rpx;
  transform: translateY(-1rpx);
}

.weather-line text:last-child {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 0;
  color: #8c6545;
}

.event-panel {
  display: flex;
  margin-top: 22rpx;
  background: #ffffff;
  border: none;
  border-radius: 20rpx;
  overflow: hidden;
}

.event-cell {
  flex: 1;
  min-height: 118rpx;
  padding: 24rpx 18rpx;
  border-right: 1rpx solid rgba(33, 90, 128, 0.08);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.event-cell:last-child {
  border-right: none;
}

.cell-label {
  color: #9398a0;
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.cell-value {
  color: #111111;
  font-size: 28rpx;
  font-weight: 700;
}

.feature-grid {
  display: flex;
  padding: 24rpx;
}

.feature {
  flex: 1;
  min-height: 176rpx;
  background: #ffffff;
  padding: 28rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(33, 90, 128, 0.08);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.feature + .feature {
  margin-left: 16rpx;
}

.feature.primary {
  background: #215a80;
  color: #ffffff;
  border-color: #215a80;
}

.weather-tab.disabled {
  color: #c0cad1;
  background: transparent;
  box-shadow: none;
}

.status-value {
  font-size: 26rpx;
}

.status-value.unregistered { color: #8b919d; }
.status-value.pending { color: #a75f24; }
.status-value.approved { color: #215a80; }
.status-value.checked-in { color: #28705a; }

.directed-invite {
  position: relative;
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  padding: 22rpx 26rpx;
  min-height: 88rpx;
  color: #0c3753;
  background: linear-gradient(135deg, #f8d6bb 0%, #dc9e6c 48%, #f5c8a3 100%);
  border: 1rpx solid rgba(171, 102, 46, .72);
  border-radius: 16rpx;
  box-shadow: 0 12rpx 28rpx rgba(146, 86, 36, .18), inset 0 0 0 1rpx rgba(255,255,255,.48);
  box-sizing: border-box;
  overflow: hidden;
}

.directed-invite::after {
  content: '';
  position: absolute;
  right: -24rpx;
  top: -42rpx;
  width: 130rpx;
  height: 130rpx;
  border: 1rpx solid rgba(95, 53, 18, .15);
  border-radius: 50%;
  box-shadow: 0 0 0 18rpx rgba(255, 242, 231, .16);
}

.invite-emblem {
  width: 62rpx;
  height: 62rpx;
  line-height: 62rpx;
  text-align: center;
  color: #124669;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  border: 1rpx solid rgba(18, 70, 105, .5);
  border-radius: 50%;
}

.invite-venue-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 22rpx;
}

.invite-venue-copy text:first-child {
  color: rgba(53, 37, 24, .62);
  font-size: 16rpx;
  line-height: 1;
  letter-spacing: 3rpx;
}

.invite-venue-copy text:last-child {
  margin-top: 10rpx;
  color: #0c3753;
  font-size: 27rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.invite-gem {
  position: relative;
  z-index: 1;
  width: 11rpx;
  height: 11rpx;
  margin-right: 10rpx;
  background: #124669;
  transform: rotate(45deg);
  box-shadow: 0 0 14rpx rgba(18, 70, 105, .28);
}

.invitation-manager {
  margin: 0 24rpx 24rpx;
  min-height: 112rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #093451, #215a80);
  color: #fff;
  border-radius: 12rpx;
  box-shadow: 0 14rpx 32rpx rgba(9, 52, 81, .15);
  box-sizing: border-box;
}

.invitation-manager .feature-no { color: #d89c6b; width: 64rpx; }
.invitation-manager .manager-copy { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.invitation-manager .feature-meta { color: rgba(255,255,255,.58); }
.invitation-manager .arrow { color: #d89c6b; font-size: 44rpx; }

.seat-entry {
  color: #152f41;
  background: linear-gradient(145deg, #fffdf8, #f8eade);
  border: 1rpx solid rgba(186, 121, 67, 0.38);
  box-shadow: 0 12rpx 30rpx rgba(33, 90, 128, 0.06);
}

.seat-entry .feature-no { color: #a9662f; }
.seat-entry .feature-meta { color: #9aa0a8; }
.seat-entry .arrow { color: #ba7b47; }

.lottery-feature {
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg, #fffdf8, #f8eade);
  border-color: rgba(186, 121, 67, 0.38);
}

.lottery-feature::after {
  content: '';
  position: absolute;
  right: -28rpx;
  top: -30rpx;
  width: 108rpx;
  height: 108rpx;
  border: 1rpx solid rgba(186, 121, 67, 0.2);
  border-radius: 50%;
  box-shadow: 0 0 0 16rpx rgba(186, 121, 67, 0.06);
}

.feature-no {
  font-size: 22rpx;
  color: #9aa0a8;
  font-weight: 700;
}

.feature.primary .feature-no,
.feature.primary .feature-meta {
  color: rgba(255, 255, 255, 0.62);
}

.feature-name {
  font-size: 32rpx;
  font-weight: 700;
}

.feature-meta {
  font-size: 18rpx;
  color: #9aa0a8;
  letter-spacing: 2rpx;
  font-weight: 600;
}

.section {
  margin: 0 24rpx;
  background: #fff;
  border: 1rpx solid rgba(201, 148, 104, 0.35);
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 34rpx rgba(33, 90, 128, 0.05);
}

.section-head {
  display: flex;
  justify-content: space-between;
  padding: 30rpx 32rpx;
  border-bottom: 1rpx solid #215a80;
}

.section-head text:first-child {
  font-size: 28rpx;
  font-weight: 700;
}

.section-head text:last-child {
  font-size: 20rpx;
  color: #9aa0a8;
  letter-spacing: 2rpx;
  font-weight: 600;
}

.menu-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #eceff1;
  box-sizing: border-box;
}

.menu-row:last-child {
  border-bottom: none;
}

.no {
  font-size: 22rpx;
  color: #9aa0a8;
  width: 76rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.menu-name {
  flex: 1;
  font-size: 30rpx;
  color: #111111;
  font-weight: 600;
  letter-spacing: 0;
}

.arrow {
  color: #9aa0a8;
  font-size: 42rpx;
  line-height: 1;
}

.invite-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  background: rgba(3, 22, 34, 0.66);
  animation: maskFade 520ms ease both;
}

.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  height: 132rpx;
  padding: 12rpx 48rpx calc(12rpx + env(safe-area-inset-bottom));
  box-sizing: content-box;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #e6edf2;
  box-shadow: 0 -12rpx 34rpx rgba(28, 63, 87, 0.06);
}

.nav-item {
  width: 172rpx;
  height: 116rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #a3a8b2;
}

.nav-item.active {
  color: #215a80;
}

.nav-text {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1;
  font-weight: 600;
}

.nav-icon {
  position: relative;
  width: 52rpx;
  height: 52rpx;
  box-sizing: border-box;
}

.home-icon {
  border: 4rpx solid currentColor;
  border-radius: 24rpx 24rpx 6rpx 6rpx;
}

.home-icon view {
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  top: 12rpx;
  bottom: -4rpx;
  border-left: 4rpx solid currentColor;
  border-right: 4rpx solid currentColor;
}

.user-icon::before {
  content: '';
  position: absolute;
  left: 13rpx;
  top: 4rpx;
  width: 26rpx;
  height: 26rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.user-icon::after {
  content: '';
  position: absolute;
  left: 5rpx;
  bottom: 2rpx;
  width: 42rpx;
  height: 25rpx;
  border: 4rpx solid currentColor;
  border-top-left-radius: 26rpx;
  border-top-right-radius: 26rpx;
  border-bottom: none;
  box-sizing: border-box;
}

.nav-center {
  width: 172rpx;
  display: flex;
  justify-content: center;
  transform: translateY(-26rpx);
}

.qr-circle {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #152f41;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 8rpx solid #ffffff;
  box-shadow: 0 18rpx 36rpx rgba(21, 47, 65, 0.24);
}

.qr-grid {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  flex-wrap: wrap;
  align-content: space-between;
  justify-content: space-between;
}

.qr-grid view {
  width: 19rpx;
  height: 19rpx;
  border: 4rpx solid #ffffff;
  box-sizing: border-box;
}

.section.service-locked .menu-name,
.section.service-locked .no,
.section.service-locked .arrow {
  color: #b8bdc7;
}

.lottery-circle {
  flex-direction: column;
  background: linear-gradient(145deg, #0e2737, #22506f);
  border-color: #fffaf0;
  box-shadow: 0 18rpx 38rpx rgba(12, 37, 54, 0.28), inset 0 0 0 1rpx rgba(221, 159, 109, 0.34);
}

.lottery-mark {
  color: #dba67a;
  font-size: 16rpx;
  line-height: 1;
  letter-spacing: 2rpx;
  font-family: Georgia, "Times New Roman", serif;
}

.lottery-mark-cn {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.invite-card {
  position: relative;
  width: 100%;
  max-width: 650rpx;
  background: #ffffff;
  border-radius: 18rpx;
  box-shadow: 0 34rpx 92rpx rgba(3, 22, 34, 0.34);
  animation: cardEnter 640ms cubic-bezier(0.18, 0.82, 0.22, 1) both;
}

.invite-inner {
  position: relative;
  z-index: 2;
  margin: 16rpx;
  padding: 58rpx 42rpx 42rpx;
  border: 2rpx solid #c99468;
  border-radius: 12rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.invite-inner::before {
  content: '';
  position: absolute;
  left: 42rpx;
  right: 42rpx;
  top: 0;
  height: 1rpx;
  background: rgba(33, 90, 128, 0.18);
}

.invite-corner {
  position: absolute;
  z-index: 3;
  width: 128rpx;
  height: 128rpx;
  background: #215a80;
  opacity: 0.96;
  overflow: hidden;
  box-shadow: 0 12rpx 26rpx rgba(3, 22, 34, 0.22);
}

.invite-corner.left {
  left: -14rpx;
  top: -14rpx;
  border-radius: 18rpx 0 88rpx 0;
}

.invite-corner.right {
  right: -14rpx;
  bottom: -14rpx;
  border-radius: 88rpx 0 18rpx 0;
}

.ribbon-fold {
  position: absolute;
  width: 96rpx;
  height: 96rpx;
  background: rgba(5, 37, 59, 0.28);
  transform: rotate(45deg);
}

.invite-corner.left .ribbon-fold {
  left: -46rpx;
  bottom: -20rpx;
}

.invite-corner.right .ribbon-fold {
  right: -46rpx;
  top: -20rpx;
}

.ribbon-thread {
  position: absolute;
  width: 88rpx;
  height: 88rpx;
  border: 2rpx solid rgba(201, 148, 104, 0.62);
}

.invite-corner.left .ribbon-thread {
  left: 14rpx;
  top: 14rpx;
  border-right: none;
  border-bottom: none;
  border-radius: 14rpx 0 0 0;
}

.invite-corner.right .ribbon-thread {
  right: 14rpx;
  bottom: 14rpx;
  border-left: none;
  border-top: none;
  border-radius: 0 0 14rpx 0;
}

.ribbon-mark {
  position: absolute;
  width: 42rpx;
  height: 42rpx;
  line-height: 42rpx;
  text-align: center;
  color: #daa67b;
  border: 1rpx solid rgba(218, 166, 123, 0.82);
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: 600;
  font-family: Georgia, "Times New Roman", serif;
}

.invite-corner.left .ribbon-mark {
  left: 24rpx;
  top: 22rpx;
}

.invite-corner.right .ribbon-mark {
  right: 24rpx;
  bottom: 22rpx;
}

.invite-corner::after {
  content: '';
  position: absolute;
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid rgba(201, 148, 104, 0.86);
  border-radius: 50%;
}

.invite-corner.left::after {
  left: 82rpx;
  top: 18rpx;
}

.invite-corner.right::after {
  right: 82rpx;
  bottom: 18rpx;
}

.invite-eyebrow {
  color: #8c6545;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 5rpx;
  text-align: center;
}

.invite-title {
  margin-top: 28rpx;
  color: #152f41;
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 700;
  text-align: center;
}

.invite-rule {
  width: 76rpx;
  height: 2rpx;
  margin: 28rpx auto 0;
  background: #c99468;
}

.invite-body {
  margin-top: 38rpx;
  color: #314c5e;
  font-size: 28rpx;
  line-height: 1.85;
  text-align: justify;
}

.invite-note {
  margin-top: 24rpx;
  color: #7d8493;
  font-size: 23rpx;
  line-height: 1.65;
}

.invite-actions {
  margin-top: 42rpx;
  display: flex;
}

.invite-btn {
  flex: 1;
  height: 86rpx;
  line-height: 86rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.invite-btn.ghost {
  color: #215a80;
  background: #ffffff;
  border: 2rpx solid #215a80;
}

.invite-btn.primary {
  margin-left: 24rpx;
  color: #ffffff;
  background: #215a80;
}

@keyframes maskFade {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes cardEnter {
  from {
    opacity: 0;
    transform: translateY(28rpx) scale(0.985);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.privacy-consent-mask { z-index:120; }
