page {
  background: #f4f6fb;
}

.page {
  min-height: 100vh;
  color: #101e28;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.head {
  position: relative;
  height: 300rpx;
  overflow: hidden;
  border-bottom-left-radius: 46rpx;
  border-bottom-right-radius: 46rpx;
  background: #07304b;
}

.head-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.head-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(4, 30, 47, 0.1), rgba(4, 30, 47, 0.78));
}

.head-copy {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: 42rpx;
  color: #ffffff;
}

.eyebrow {
  color: rgba(255, 255, 255, 0.78);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.title {
  margin-top: 14rpx;
  font-size: 48rpx;
  line-height: 1.08;
  font-weight: 800;
}

.gold-line {
  margin-top: 18rpx;
  width: 82rpx;
  height: 3rpx;
  background: #d99c6a;
}

.sub {
  margin-top: 16rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.82);
}

.state-card {
  margin: -28rpx 28rpx 0;
  padding: 54rpx 40rpx;
  color: #6f7788;
  font-size: 25rpx;
  line-height: 1.7;
  text-align: center;
  background: #ffffff;
  border: 1rpx solid rgba(217, 156, 106, 0.22);
  border-radius: 24rpx;
  box-shadow: 0 26rpx 56rpx rgba(9, 52, 80, 0.1);
}

.seat-card {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 28rpx 0;
  padding: 32rpx 36rpx;
  overflow: hidden;
  color: #0c3753;
  background: linear-gradient(135deg, #f8d6bb 0%, #dc9e6c 48%, #f5c8a3 100%);
  border: 1rpx solid rgba(171, 102, 46, 0.72);
  border-radius: 20rpx;
  box-shadow: 0 16rpx 36rpx rgba(146, 86, 36, 0.18), inset 0 0 0 1rpx rgba(255, 255, 255, 0.48);
}

.seat-card:first-child {
  margin-top: -28rpx;
}

.seat-card::after {
  content: '';
  position: absolute;
  right: -30rpx;
  top: -48rpx;
  width: 150rpx;
  height: 150rpx;
  border: 1rpx solid rgba(95, 53, 18, 0.16);
  border-radius: 50%;
}

.seat-name {
  position: relative;
  color: #143952;
  font-size: 32rpx;
  font-weight: 800;
}

.seat-no-row {
  position: relative;
  display: flex;
  align-items: baseline;
}

.seat-no {
  color: #0c3753;
  font-size: 72rpx;
  line-height: 1;
  font-weight: 800;
}

.seat-unit {
  margin-left: 10rpx;
  color: #0c3753;
  font-size: 26rpx;
  font-weight: 700;
}

.hall-image {
  display: block;
  width: calc(100% - 56rpx);
  margin: 28rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 40rpx rgba(9, 52, 80, 0.1);
}

.hall-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 420rpx;
  margin: 28rpx;
  color: #a7b5be;
  font-size: 24rpx;
  background: #ffffff;
  border: 2rpx dashed #d3dee5;
  border-radius: 20rpx;
}
